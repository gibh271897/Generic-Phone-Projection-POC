@PACKAGE_INIT@

include(CMakeFindDependencyMacro)

# Dependencies
find_dependency(fmt REQUIRED)
find_dependency(nlohmann_json REQUIRED)

# Include targets
include("${CMAKE_CURRENT_LIST_DIR}/PhoneProjectionMiddlewareTargets.cmake")

# Version variables
set(PhoneProjectionMiddleware_VERSION @PROJECT_VERSION@)
set(PhoneProjectionMiddleware_VERSION_MAJOR @PROJECT_VERSION_MAJOR@)
set(PhoneProjectionMiddleware_VERSION_MINOR @PROJECT_VERSION_MINOR@)
set(PhoneProjectionMiddleware_VERSION_PATCH @PROJECT_VERSION_PATCH@)